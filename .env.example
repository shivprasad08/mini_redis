# mini-redis Docker Compose Environment Configuration
# Copy this file to .env to override defaults if necessary

# Client-facing TCP ports published on host
NODE_A_PORT=6380
NODE_B_PORT=6381
NODE_C_PORT=6382

# Internal cluster ports
MINIREDIS_TCP_PORT=6380
MINIREDIS_GRPC_PORT=6381

# Cluster configuration
WRITE_MODE=async
MUTEX_ALGO=ricart-agrawala
ELECTION_ALGO=bully
SIMULATE_LATENCY_MS=0.0
CLOCK_SKEW_MS=0.0

# M20 ledger durability policy: always | batch | interval
FSYNC_POLICY=always
